# ── Render / Production Environment Variables ──────────────────────────────
# Copy these into Render → Environment → Add Environment Variable

APP_NAME=Bleep Student Assignment Portal
APP_ENV=production
BASE_URL=https://your-app-name.onrender.com

SECRET_KEY=replace-with-a-strong-random-secret-key-min-32-chars

# Admin credentials
ADMIN_EMAIL=amansah1717@gmail.com
ADMIN_PASSWORD=Amansah@1717

# Google OAuth Client (from client_secret JSON — find these in Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=https://your-app-name.onrender.com/auth/google/callback

# Google Sheets database
GOOGLE_SHEET_ID=1FVFLX_foJv_n_G5iEdcWC2T7Aa2o5vVgpgO0rKbig00

# Shared root Drive folder (open-link folder)
# https://drive.google.com/drive/folders/1TlQK2zmq1IaFhkavyjlapOtcglOOB9oS
DRIVE_ROOT_FOLDER_ID=1TlQK2zmq1IaFhkavyjlapOtcglOOB9oS

# Google Drive auth — use ONE of these two options:
#
# Option A (Recommended): Service Account JSON — paste the full JSON on one line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Option B: Admin refresh token (obtained from /auth/admin/oauth-drive flow)
# GOOGLE_REFRESH_TOKEN=1//0gXXXXXXXXXXXXXXXXXXX
